<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Category listing pages: SQL-level stock sort (in-stock first) -->
    <type name="Magento\Catalog\Model\ResourceModel\Product\Collection">
        <plugin name="ecsso_sort_by_stock" type="Ecsso\InStockSort\Plugin\ProductCollectionPlugin"/>
    </type>

    <!-- Search results pages (Amasty ElasticSearch): prepend is_out_of_stock DESC sort -->
    <type name="Amasty\ElasticSearch\Model\Search\GetRequestQuery\SortingProvider">
        <plugin name="ecsso_sort_by_stock_amasty" type="Ecsso\InStockSort\Plugin\AmastySearchSortingPlugin"/>
    </type>

    <!-- DEBUG: detect which search engine handles the search results page -->
    <!-- Remove both debug plugins after confirming which module is active  -->
    <type name="Amasty\ElasticSearch\Model\Search\GetRequestQuery\SortingProvider">
        <plugin name="ecsso_debug_amasty" type="Ecsso\InStockSort\Plugin\SearchCollectionDebugPlugin"/>
    </type>
    <type name="Magento\CatalogSearch\Model\ResourceModel\Fulltext\Collection">
        <plugin name="ecsso_debug_fulltext" type="Ecsso\InStockSort\Plugin\SearchCollectionDebugPlugin"/>
    </type>

</config>
