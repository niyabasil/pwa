<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Category listing pages: SQL-level stock sort (in-stock first) -->
    <type name="Magento\Catalog\Model\ResourceModel\Product\Collection">
        <plugin name="ecsso_sort_by_stock" type="Ecsso\InStockSort\Plugin\ProductCollectionPlugin"/>
    </type>

    <!-- Search results pages (Amasty ElasticSearch): prepend is_out_of_stock DESC sort -->
    <!-- is_out_of_stock field: 1=in stock, 0=out of stock — DESC puts in-stock first globally -->
    <type name="Amasty\ElasticSearch\Model\Search\GetRequestQuery\SortingProvider">
        <plugin name="ecsso_sort_by_stock_amasty" type="Ecsso\InStockSort\Plugin\AmastySearchSortingPlugin"/>
    </type>

</config>
